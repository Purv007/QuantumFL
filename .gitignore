# ========================================
# QuantumShieldFL .gitignore
# ========================================
# This file tells Git which files/folders to
# exclude from version control because they
# are auto-generated, temporary, or too large.
# ========================================

# --- Python Bytecode Cache ---
# WHY: Auto-generated by Python every time you import a module.
#      These are machine-specific compiled files, not source code.
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Pytest Cache ---
# WHY: Auto-generated by pytest to speed up re-runs.
#      Contains no test logic, just internal caching metadata.
.pytest_cache/

# --- Virtual Environment ---
# WHY: Contains all installed pip packages (~hundreds of MBs).
#      Anyone cloning the repo will recreate this via `pip install -r requirements.txt`.
venv/
env/
.venv/

# --- MNIST Dataset ---
# WHY: ~60MB of raw image data auto-downloaded by PyTorch on first run.
#      Anyone cloning the repo will auto-download it when they run the experiment.
data/

# --- SQLite Database (experiment results) ---
# WHY: This is a runtime artifact generated by running experiments.
#      Each user generates their own results. Including it would cause
#      merge conflicts and bloat the repo with binary data.
experiments/results/*.db

# --- Scratch/Debug Scripts ---
# WHY: These are one-off throwaway scripts created during development
#      for debugging database issues, testing imports, etc.
#      They are not part of the project's core logic.
scratch_test.py
scratch_test2.py
scratch_test3.py
scratch_test4.py
scratch_test5.py

# --- Database Seeding Script ---
# WHY: One-time utility script used to populate the database with
#      demo data for the dashboard. Not part of the core architecture.
seed_database.py

# --- Demo & Guide Scripts ---
# WHY: These are standalone walkthrough/demo scripts for manual testing
#      and presentation purposes. They don't contribute to the core
#      project functionality (no module imports them).
demo.py
run_guide.py

# --- Documentation (non-README) ---
# WHY: Supplementary markdown docs for personal reference, manual testing
#      guides, and patent brainstorming. The README.md alone serves as
#      the official project documentation for GitHub.
MANUAL_GUIDE.md
PROJECT_NOVELTY_AND_PATENTABILITY.md

# --- IDE & Editor Settings ---
# WHY: Personal editor preferences (VS Code, PyCharm, etc.)
#      that vary per developer.
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS-Generated Files ---
# WHY: Hidden metadata files created by Windows/macOS file explorers.
#      They have zero relevance to the codebase.
Thumbs.db
.DS_Store
desktop.ini

# --- Distribution / Packaging ---
# WHY: Auto-generated build artifacts if you ever run `pip install .`
#      or `python setup.py`. Not source code.
dist/
build/
*.egg-info/
*.egg

# --- Jupyter Notebooks Checkpoints ---
# WHY: Auto-saved checkpoint files created by Jupyter.
.ipynb_checkpoints/

# --- Log Files ---
# WHY: Runtime output logs that are machine-specific and regenerated on each run.
*.log
logs/
